generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DONOR
  NGO
  ADMIN
}

enum NGOStatus {
  DRAFT
  PENDING
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  ACTION_REQUIRED
  REJECTED
  SUSPENDED
}

enum DocumentType {
  REGISTRATION_CERTIFICATE
  TAX_CERTIFICATE
  PAN_CARD
  BANK_PROOF
  OTHER
}

enum DocumentReviewStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTION_REQUIRED
}

enum LedgerType {
  CREDIT
  DEBIT
  REFUND
  PAYOUT
  TOPUP
  DONATION_HOLD
  DONATION_DEBIT
  REVERSAL
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum DonationStatus {
  PENDING
  COMPLETED
  PARTIALLY_ALLOCATED
  ALLOCATED
  CANCELLED
  FAILED
  REFUNDED
}

enum AllocationStatus {
  PROPOSED
  APPROVED
  COMPLETED
  REJECTED
}

enum AllocationAuthorizationStatus {
  NOT_AUTHORIZED
  ACTIVE
  PAUSED
  REVOKED
}

enum ScheduleFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum ScheduleType {
  ONE_TIME
  RECURRING
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
  FAILED
}

enum ImpactReportStatus {
  DRAFT
  SUBMITTED
  CORRECTIONS_REQUESTED
  REVIEWED
}

enum ReportVerification {
  NGO_REPORTED
  ADMIN_REVIEWED
  INDEPENDENTLY_VERIFIED
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum EvidenceType {
  IMAGE
  VIDEO
  DOCUMENT
  LINK
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

enum InitiativeStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  password      String
  role          UserRole @default(DONOR)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)

  donorProfile        DonorProfile?
  ngoProfile          NGOProfile?
  paymentTransactions PaymentTransaction[]
  agentExecutions     AgentExecution[]
  auditLogs           AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

model DonorProfile {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @unique @db.Uuid
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String  @default("India")
  anonymous Boolean @default(false)

  // Donor preferences (defaults copied into a policy snapshot when authorizing)
  preferredCauseIds      String[] @default([])
  excludedCauseIds       String[] @default([])
  preferredNgoIds        String[] @default([])
  monthlyBudgetPaise     BigInt?
  maxDonationPerNgoPaise BigInt?
  maxNgosPerAllocation   Int      @default(3)
  minDonationPaise       BigInt   @default(0)
  donateAnyCause         Boolean  @default(false)

  // Ambassador / referrals
  referralCode   String? @unique
  referredByCode String?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAccount WalletAccount?
  donations     Donation[]
  policies      AllocationPolicy[]
  schedules     DonationSchedule[]
  favorites     DonorFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referredByCode])
}

model NGOProfile {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @db.Uuid
  organizationName     String
  registrationNumber   String?   @unique
  description          String?
  website              String?
  phone                String?
  address              String?
  city                 String?
  state                String?
  country              String    @default("India")
  status               NGOStatus @default(PENDING)
  verifiedAt           DateTime?
  legalName            String?
  mission              String?
  vision               String?
  minimumDonationPaise BigInt?
  logoUrl              String?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewNote           String?
  galleryUrls          String[]  @default([])

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  causes        NGOCause[]
  documents     NGODocument[]
  allocations   DonationAllocation[]
  impactReports ImpactReport[]
  payouts       NGOPayout[]
  initiatives   Initiative[]
  favorites     DonorFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([city, state])
}

model Cause {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  ngos        NGOCause[]
  initiatives Initiative[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model NGOCause {
  id      String @id @default(uuid()) @db.Uuid
  ngoId   String @db.Uuid
  causeId String @db.Uuid

  ngo   NGOProfile @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  cause Cause      @relation(fields: [causeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ngoId, causeId])
  @@index([causeId])
}

model NGODocument {
  id         String       @id @default(uuid()) @db.Uuid
  ngoId      String       @db.Uuid
  type       DocumentType
  fileName   String
  fileUrl    String
  verified   Boolean      @default(false)
  verifiedAt DateTime?

  reviewStatus DocumentReviewStatus @default(PENDING)
  reviewReason String?
  reviewedAt   DateTime?
  fileSize     Int?
  mimeType     String?

  ngo NGOProfile @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ngoId, type])
  @@index([ngoId, reviewStatus])
}

model WalletAccount {
  id                   String  @id @default(uuid()) @db.Uuid
  donorId              String  @unique @db.Uuid
  balancePaise         BigInt  @default(0)
  currency             String  @default("INR")
  isActive             Boolean @default(true)
  reservedBalancePaise BigInt  @default(0)

  donor         DonorProfile   @relation(fields: [donorId], references: [id], onDelete: Cascade)
  ledgerEntries WalletLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletLedger {
  id                String     @id @default(uuid()) @db.Uuid
  walletId          String     @db.Uuid
  type              LedgerType
  amountPaise       BigInt
  balanceAfterPaise BigInt
  referenceId       String?    @db.Uuid
  description       String
  idempotencyKey    String?    @unique
  reservedAfterPaise BigInt    @default(0)

  wallet WalletAccount @relation(fields: [walletId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([referenceId])
}

model PaymentTransaction {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  donationId        String?           @db.Uuid
  provider          String
  providerOrderId   String?           @unique
  providerPaymentId String?           @unique
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("INR")
  status            TransactionStatus @default(PENDING)
  idempotencyKey    String?           @unique
  metadata          Json?

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  donation Donation? @relation(fields: [donationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model Donation {
  id          String         @id @default(uuid()) @db.Uuid
  donorId     String         @db.Uuid
  scheduleId  String?        @db.Uuid
  amountPaise BigInt
  currency    String         @default("INR")
  status      DonationStatus @default(PENDING)
  message     String?
  isAnonymous Boolean        @default(false)
  idempotencyKey String?     @unique
  policyId    String?        @db.Uuid
  executionId String?        @db.Uuid
  source      String         @default("MANUAL")
  explanation String?

  donor        DonorProfile         @relation(fields: [donorId], references: [id], onDelete: Restrict)
  schedule     DonationSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  allocations  DonationAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([donorId, createdAt])
  @@index([status])
}

model DonationAllocation {
  id          String           @id @default(uuid()) @db.Uuid
  donationId  String           @db.Uuid
  ngoId       String           @db.Uuid
  amountPaise BigInt
  status      AllocationStatus @default(PROPOSED)
  matchScore  Float?
  reason      String?
  breakdown   Json?

  payout        NGOPayout?
  donation      Donation       @relation(fields: [donationId], references: [id], onDelete: Restrict)
  ngo           NGOProfile     @relation(fields: [ngoId], references: [id], onDelete: Restrict)
  impactReports ImpactReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([donationId, ngoId])
  @@index([ngoId, status])
}

model AllocationPolicy {
  id      String @id @default(uuid()) @db.Uuid
  donorId String @db.Uuid
  name    String

  // Donation limits
  monthlyLimitPaise      BigInt?
  minDonationPaise       BigInt  @default(0)
  maxDonationPaise       BigInt?
  maxDonationPerNGOPaise BigInt?
  maxNGOsPerAllocation   Int     @default(3)

  // Cause and NGO preferences
  allowedCauseIds  String[] @default([])
  excludedCauseIds String[] @default([])
  allowedNGOIds    String[] @default([])

  // Authorization and consent
  authorizationStatus      AllocationAuthorizationStatus @default(NOT_AUTHORIZED)
  authorizationTextVersion String?
  authorizedAt             DateTime?
  revokedAt                DateTime?
  pausedAt                 DateTime?
  authorizationText        String?
  allowAnyCause            Boolean @default(false)
  anonymous                Boolean @default(false)

  isActive Boolean @default(false)

  donor DonorProfile @relation(fields: [donorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([donorId, isActive])
  @@index([donorId, authorizationStatus])
}

model DonorFavorite {
  id      String @id @default(uuid()) @db.Uuid
  donorId String @db.Uuid
  ngoId   String @db.Uuid

  donor DonorProfile @relation(fields: [donorId], references: [id], onDelete: Cascade)
  ngo   NGOProfile   @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([donorId, ngoId])
  @@index([donorId])
  @@index([ngoId])
}

model DonationSchedule {
  id          String            @id @default(uuid()) @db.Uuid
  donorId     String            @db.Uuid
  name        String            @default("")
  type        ScheduleType      @default(RECURRING)
  status      ScheduleStatus    @default(ACTIVE)
  amountPaise BigInt
  frequency   ScheduleFrequency
  intervalDays Int?
  startDate   DateTime          @default(now())
  endDate     DateTime?
  nextRunAt   DateTime
  isActive    Boolean           @default(true)
  budgetLimitPaise BigInt?
  spentPaise  BigInt            @default(0)
  causeIds    String[]          @default([])
  lastRunAt   DateTime?
  lastRunStatus String?
  lastError   String?
  runCount    Int               @default(0)

  donor     DonorProfile @relation(fields: [donorId], references: [id], onDelete: Cascade)
  donations Donation[]
  runs      ScheduleRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nextRunAt, isActive])
  @@index([donorId, status])
}

model ScheduleRun {
  id             String   @id @default(uuid()) @db.Uuid
  scheduleId     String   @db.Uuid
  scheduledFor   DateTime
  status         String
  message        String?
  donationId     String?  @db.Uuid
  executionId    String?  @db.Uuid
  idempotencyKey String   @unique

  schedule DonationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([scheduleId, scheduledFor])
}

model AgentWorkflow {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  version     String  @default("1.0")
  isActive    Boolean @default(true)

  executions AgentExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentExecution {
  id          String         @id @default(uuid()) @db.Uuid
  workflowId  String         @db.Uuid
  userId      String?        @db.Uuid
  status      WorkflowStatus @default(PENDING)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  idempotencyKey String?  @unique
  trigger     String      @default("MANUAL")
  currentNode String?
  scheduleId  String?     @db.Uuid

  workflow AgentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  steps    AgentStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId, status])
  @@index([userId, createdAt])
}

model AgentStep {
  id          String         @id @default(uuid()) @db.Uuid
  executionId String         @db.Uuid
  node        String
  status      WorkflowStatus @default(PENDING)
  attempt     Int            @default(1)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([executionId, createdAt])
}

model ImpactReport {
  id              String   @id @default(uuid()) @db.Uuid
  ngoId           String   @db.Uuid
  allocationId    String?  @db.Uuid
  title           String
  description     String
  peopleImpacted  Int?
  amountUsedPaise BigInt?
  reportedAt      DateTime @default(now())
  status          ImpactReportStatus @default(DRAFT)
  verificationLevel ReportVerification @default(NGO_REPORTED)
  beneficiaries   Json     @default("[]")
  fundUtilization Json     @default("[]")
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewNote      String?
  reviewedById    String?  @db.Uuid

  ngo        NGOProfile          @relation(fields: [ngoId], references: [id], onDelete: Restrict)
  allocation DonationAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  evidence   ImpactEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ngoId, reportedAt])
  @@index([status])
}

model ImpactEvidence {
  id          String       @id @default(uuid()) @db.Uuid
  reportId    String       @db.Uuid
  type        EvidenceType
  title       String?
  url         String
  description String?
  fileName    String?
  storagePath String?
  mimeType    String?
  fileSize    Int?

  report ImpactReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model NGOPayout {
  id          String       @id @default(uuid()) @db.Uuid
  ngoId       String       @db.Uuid
  amountPaise BigInt
  currency    String       @default("INR")
  status      PayoutStatus @default(REQUESTED)
  reference   String?      @unique
  processedAt DateTime?
  allocationId String?     @unique @db.Uuid

  ngo        NGOProfile          @relation(fields: [ngoId], references: [id], onDelete: Restrict)
  allocation DonationAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ngoId, status])
}

model AuditLog {
  id        String  @id @default(uuid()) @db.Uuid
  actorId   String? @db.Uuid
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(255)
  subject   String   @db.VarChar(150)
  message   String   @db.Text
  status    String   @default("NEW") @db.VarChar(20)
  userId    String?  @db.Uuid
  role      String?  @db.VarChar(20)
  adminNote String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Initiative {
  id                String           @id @default(uuid()) @db.Uuid
  ngoId             String           @db.Uuid
  causeId           String           @db.Uuid
  title             String
  description       String
  targetAmountPaise BigInt?
  startDate         DateTime?
  endDate           DateTime?
  status            InitiativeStatus @default(DRAFT)

  ngo   NGOProfile @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  cause Cause      @relation(fields: [causeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ngoId])
  @@index([causeId])
  @@index([status])
}
