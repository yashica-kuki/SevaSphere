# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL (create an empty database first, e.g. `createdb sevakarma`)
DATABASE_URL="postgresql://postgres:Poiu@#$%159874@db.gunsxwlfpefowpocvsfi.supabase.co:5432/postgres"

# Authentication — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=sevakarma_token

# AI (optional). Without a key the app uses deterministic fallbacks and says so in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PayPal Sandbox (optional). Create a sandbox REST app at https://developer.paypal.com
# Payments are in USD and are completely separate from the simulated INR wallet.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Scheduler (database-backed poller for scheduled donations)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=30000
